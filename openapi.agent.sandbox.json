  },
  "externalDocs": {
    "description": "MVR API AI-agent quickstart",
    "url": "https://africanmarketos.com/docs/quickstart-ai-agents.md"
  },
  "x-mvr-tool-profile": {
    "id": "public-preflight-read-only-v1",
    "tool_count": 5,
    "mcp_endpoint": "https://africanmarketos.com/mcp/preflight",
    "canonical_sequence": [
      "mvr_first_call",
      "mvr_entity_resolve",
