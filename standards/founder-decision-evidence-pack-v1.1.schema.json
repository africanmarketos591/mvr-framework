{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://africanmarketos.com/standards/founder-decision-evidence-pack-v1.1.schema.json",
  "title": "AMOS Founder Decision Evidence Pack v1.1",
  "description": "A founder-generated, browser-local record of one scoped decision, a founder-written business translation, an external dependency check, current evidence gaps, and one reversible experiment. It is not an AMOS assessment, verification, score, diagnosis, or authorization.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens",
        "label",
        "answer_state",
        "evidence_state",
        "observation"
      ],
      "properties": {
        "lens": {
          "enum": [
            "demand_reality",
            "value_and_offer",
            "economic_health",
            "customer_continuity",
            "delivery_reliability",
            "team_and_decision_architecture",
            "learning_and_adaptation"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "answer_state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "evidence_state": {
          "enum": [
            "none",
            "observed",
            "internal_record",
            "artifact_reviewed_by_founder"
          ]
        },
        "observation": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "answer_state": {
                "enum": [
                  "unknown",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "answer_state"
            ]
          },
          "then": {
            "properties": {
              "evidence_state": {
                "const": "none"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "tool_version",
    "pack_id",
    "generated_at",
    "pack_expires_at",
    "founder_held_reference",
    "origin",
    "completion_state",
    "decision",
    "business_translation",
    "relational_dependency",
    "evidence_snapshot",
    "priority_gaps",
    "experiment",
    "safe_next_action",
    "unsafe_claim_to_avoid",
    "sharing_boundary",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "tool_version": {
      "const": "2026-08-29.4"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Random UUID generated in the founder's browser for this exact pack. It is not a person, venture, programme, account, verification, or authority identifier."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Browser-local pack generation timestamp and evidence-snapshot as-of time."
    },
    "pack_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Founder-set currentness review deadline computed from generated_at plus decision.horizon_days. It is not AMOS-certified validity and does not establish the freshness or expiry of any source fact."
    },
    "founder_held_reference": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._-]{0,79})$",
      "description": "Optional founder-controlled local alias. A pseudonym is not anonymous and this value is not assigned or verified by AMOS; do not use names, contact details, account numbers, or programme identifiers."
    },
    "origin": {
      "const": "browser_local_founder_generated"
    },
    "completion_state": {
      "const": "planning_complete"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "statement",
        "horizon_days",
        "scope"
      ],
      "properties": {
        "type": {
          "enum": [
            "market_entry",
            "fundraising",
            "partnership",
            "hiring_or_delegation",
            "scaling",
            "product_or_offer",
            "other"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 12,
          "maxLength": 500
        },
        "horizon_days": {
          "type": "integer",
          "minimum": 7,
          "maximum": 365
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "market_or_context",
            "segment_or_stakeholder",
            "offering_or_initiative"
          ],
          "properties": {
            "market_or_context": {
              "type": "string",
              "minLength": 2,
              "maxLength": 160
            },
            "segment_or_stakeholder": {
              "type": "string",
              "minLength": 2,
              "maxLength": 160
            },
            "offering_or_initiative": {
              "type": "string",
              "minLength": 2,
              "maxLength": 160
            }
          }
        }
      }
    },
    "business_translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_by_founder",
        "operating_action_to_test",
        "venture_process_to_watch",
        "external_response_to_watch",
        "source",
        "private_reflection_imported"
      ],
      "properties": {
        "included_by_founder": {
          "type": "boolean"
        },
        "operating_action_to_test": {
          "type": "string",
          "maxLength": 240
        },
        "venture_process_to_watch": {
          "type": "string",
          "maxLength": 240
        },
        "external_response_to_watch": {
          "type": "string",
          "maxLength": 240
        },
        "source": {
          "const": "founder_written_business_translation"
        },
        "private_reflection_imported": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "included_by_founder": {
                "const": true
              }
            },
            "required": [
              "included_by_founder"
            ]
          },
          "then": {
            "properties": {
              "operating_action_to_test": {
                "minLength": 3
              },
              "venture_process_to_watch": {
                "minLength": 3
              },
              "external_response_to_watch": {
                "minLength": 3
              }
            }
          },
          "else": {
            "properties": {
              "operating_action_to_test": {
                "const": ""
              },
              "venture_process_to_watch": {
                "const": ""
              },
              "external_response_to_watch": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "relational_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "counterparty_class",
        "required_behavior",
        "permission_state",
        "current_evidence_state",
        "evidence_summary",
        "disconfirming_signal"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "present",
            "uncertain"
          ]
        },
        "counterparty_class": {
          "enum": [
            "not_applicable",
            "customer",
            "partner_or_distributor",
            "supplier",
            "team_or_employee",
            "investor_or_funder",
            "public_authority",
            "community_or_network",
            "other"
          ]
        },
        "required_behavior": {
          "enum": [
            "not_applicable",
            "permit",
            "repeat",
            "trust",
            "refer",
            "adopt",
            "vouch",
            "carry",
            "renew",
            "other"
          ]
        },
        "permission_state": {
          "enum": [
            "not_applicable",
            "confirmed_for_bounded_test",
            "not_confirmed",
            "unknown"
          ]
        },
        "current_evidence_state": {
          "enum": [
            "none",
            "observed",
            "internal_record",
            "artifact_reviewed_by_founder"
          ]
        },
        "evidence_summary": {
          "type": "string",
          "maxLength": 400
        },
        "disconfirming_signal": {
          "type": "string",
          "maxLength": 400
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "none"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "counterparty_class": {
                "const": "not_applicable"
              },
              "required_behavior": {
                "const": "not_applicable"
              },
              "permission_state": {
                "const": "not_applicable"
              },
              "current_evidence_state": {
                "const": "none"
              },
              "evidence_summary": {
                "const": ""
              },
              "disconfirming_signal": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "counterparty_class": {
                "not": {
                  "const": "not_applicable"
                }
              },
              "required_behavior": {
                "not": {
                  "const": "not_applicable"
                }
              },
              "permission_state": {
                "not": {
                  "const": "not_applicable"
                }
              },
              "disconfirming_signal": {
                "minLength": 3
              }
            }
          }
        }
      ]
    },
    "evidence_snapshot": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/evidence_row"
            },
            {
              "properties": {
                "lens": {
                  "const": "demand_reality"
                },
                "label": {
                  "const": "Demand reality"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/evidence_row"
            },
            {
              "properties": {
                "lens": {
                  "const": "value_and_offer"
                },
                "label": {
                  "const": "Value and offer"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/evidence_row"
            },
            {
              "properties": {
                "lens": {
                  "const": "economic_health"
                },
                "label": {
                  "const": "Economic health"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/evidence_row"
            },
            {
              "properties": {
                "lens": {
                  "const": "customer_continuity"
                },
                "label": {
                  "const": "Customer continuity"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/evidence_row"
            },
            {
              "properties": {
                "lens": {
                  "const": "delivery_reliability"
                },
                "label": {
                  "const": "Delivery reliability"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/evidence_row"
            },
            {
              "properties": {
                "lens": {
                  "const": "team_and_decision_architecture"
                },
                "label": {
                  "const": "Team and decision architecture"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/evidence_row"
            },
            {
              "properties": {
                "lens": {
                  "const": "learning_and_adaptation"
                },
                "label": {
                  "const": "Learning and adaptation"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "priority_gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 300
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_to_test",
        "reversible_action",
        "expected_observation",
        "stop_rule",
        "evidence_to_keep",
        "review_date",
        "support_request"
      ],
      "properties": {
        "risk_to_test": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "reversible_action": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "expected_observation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "stop_rule": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "evidence_to_keep": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "review_date": {
          "type": "string",
          "format": "date"
        },
        "support_request": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "safe_next_action": {
      "enum": [
        "gather_evidence_only",
        "run_reversible_test",
        "proceed_with_bounded_pilot",
        "pause_and_seek_specialist_review"
      ]
    },
    "unsafe_claim_to_avoid": {
      "type": "string",
      "minLength": 3,
      "maxLength": 400
    },
    "sharing_boundary": {
      "enum": [
        "private_draft",
        "founder_selected_coach",
        "founder_selected_programme",
        "founder_selected_external_conversation"
      ]
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_reflection_excluded",
        "no_score",
        "no_verification",
        "no_decision_authorization",
        "founder_controlled_export",
        "no_source_contact",
        "source_instrument_results_imported",
        "no_psychological_causal_inference"
      ],
      "properties": {
        "private_reflection_excluded": {
          "const": true
        },
        "no_score": {
          "const": true
        },
        "no_verification": {
          "const": true
        },
        "no_decision_authorization": {
          "const": true
        },
        "founder_controlled_export": {
          "const": true
        },
        "no_source_contact": {
          "const": true
        },
        "source_instrument_results_imported": {
          "const": false
        },
        "no_psychological_causal_inference": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "relational_dependency": {
            "properties": {
              "state": {
                "enum": [
                  "present",
                  "uncertain"
                ]
              },
              "permission_state": {
                "enum": [
                  "not_confirmed",
                  "unknown"
                ]
              }
            },
            "required": [
              "state",
              "permission_state"
            ]
          }
        },
        "required": [
          "relational_dependency"
        ]
      },
      "then": {
        "properties": {
          "safe_next_action": {
            "enum": [
              "gather_evidence_only",
              "pause_and_seek_specialist_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relational_dependency": {
            "properties": {
              "state": {
                "enum": [
                  "present",
                  "uncertain"
                ]
              },
              "current_evidence_state": {
                "const": "none"
              }
            },
            "required": [
              "state",
              "current_evidence_state"
            ]
          }
        },
        "required": [
          "relational_dependency"
        ]
      },
      "then": {
        "properties": {
          "safe_next_action": {
            "enum": [
              "gather_evidence_only",
              "pause_and_seek_specialist_review"
            ]
          }
        }
      }
    }
  ]
}
